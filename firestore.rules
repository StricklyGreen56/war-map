rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admins are listed in the `admins` collection, which can only be changed in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Editors are people an admin approved on the map.
    function isEditor() {
      return signedIn() && (isAdmin()
        || exists(/databases/$(database)/documents/editors/$(request.auth.uid)));
    }
    function str(v, max) { return v is string && v.size() <= max; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Anyone signed in can ask for edit access; only admins see the list.
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && str(request.resource.data.name, 24)
        && str(request.resource.data.email, 120)
        && request.resource.data.at is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /editors/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'at', 'by'])
        && str(request.resource.data.name, 24)
        && str(request.resource.data.by, 24)
        && request.resource.data.at is number;
      allow delete: if isAdmin();
    }

    match /pins/{id} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['tile', 'kind', 'text', 'name', 'at'])
        && str(request.resource.data.tile, 5)
        && str(request.resource.data.kind, 10)
        && str(request.resource.data.text, 200)
        && str(request.resource.data.name, 24)
        && request.resource.data.at is number;
      allow delete: if isEditor();
    }

    match /owners/{tile} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['guild', 'name', 'at'])
        && str(request.resource.data.guild, 8)
        && str(request.resource.data.name, 24)
        && request.resource.data.at is number;
      allow delete: if isEditor();
    }

    match /log/{id} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['text', 'name', 'at'])
        && str(request.resource.data.text, 200)
        && str(request.resource.data.name, 24)
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ---------- Guild schedule (schedule.html) ----------
    // Guild members are people an admin approved on the schedule page. Separate from map editors.
    function isMember() {
      return signedIn() && (isAdmin()
        || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }

    // Anyone signed in can ask to join; only admins see the list.
    match /guildRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && str(request.resource.data.name, 24)
        && str(request.resource.data.email, 120)
        && request.resource.data.at is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Officers are members an admin marked with officer: true. They can set anyone's hours.
    function isOfficer() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('officer', false) == true);
    }

    // The guild roster. Only members see it; a person can check their own entry.
    // manual = added by an admin for someone without an account.
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'at', 'by', 'manual', 'officer'])
        && str(request.resource.data.name, 24)
        && str(request.resource.data.by, 24)
        && request.resource.data.at is number;
      // A member can change their own name, and nothing else on their entry.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && str(request.resource.data.name, 24)
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Weekly availability. slots = hour numbers 0-167 in server time (0 = Monday 00:00).
    // Members set their own hours; officers and admins can set anyone's.
    match /avail/{uid} {
      allow read: if isMember();
      allow create, update: if ((isMember() && request.auth.uid == uid) || isOfficer())
        && request.resource.data.keys().hasOnly(['name', 'slots', 'at'])
        && str(request.resource.data.name, 24)
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 168
        && request.resource.data.at is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Events on real dates. start = epoch ms; dur = hours. Officers and admins post them.
    match /events/{id} {
      allow read: if isMember();
      allow create, update: if isOfficer()
        && request.resource.data.keys().hasOnly(['title', 'start', 'dur', 'note', 'by', 'at'])
        && str(request.resource.data.title, 60) && request.resource.data.title.size() > 0
        && request.resource.data.start is number
        && request.resource.data.dur is number && request.resource.data.dur >= 1 && request.resource.data.dur <= 12
        && str(request.resource.data.note, 200)
        && str(request.resource.data.by, 24)
        && request.resource.data.at is number;
      allow delete: if isOfficer();
    }

    // RSVPs. Document ID is <eventId>_<uid>. Members answer for themselves.
    match /rsvps/{rid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['ev', 'uid', 'name', 'going', 'at'])
        && str(request.resource.data.ev, 40)
        && str(request.resource.data.uid, 128)
        && str(request.resource.data.name, 24)
        && request.resource.data.going is bool
        && request.resource.data.at is number
        && rid == request.resource.data.ev + '_' + request.resource.data.uid
        && (request.resource.data.uid == request.auth.uid || isOfficer());
      allow delete: if isOfficer() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Days a member is away (dates as YYYY-MM-DD, server calendar).
    match /away/{uid} {
      allow read: if isMember();
      allow create, update: if ((isMember() && request.auth.uid == uid) || isOfficer())
        && request.resource.data.keys().hasOnly(['name', 'dates', 'at'])
        && str(request.resource.data.name, 24)
        && request.resource.data.dates is list
        && request.resource.data.dates.size() <= 60
        && request.resource.data.at is number;
      allow delete: if isOfficer() || (signedIn() && request.auth.uid == uid);
    }

    // Anything else (including the old passcode) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
